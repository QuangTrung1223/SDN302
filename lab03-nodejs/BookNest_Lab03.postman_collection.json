            }
          ]
        },
        {
          "name": "POST /api/books (Create Success -> 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Express in Action\",\n  \"author\": \"Evan Hahn\",\n  \"category\": \"IT\",\n  \"price\": 39.99,\n  \"stock\": 18\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Generated identifier automatically', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.be.a('number');",
                  "    pm.expect(json.data.title).to.eql('Express in Action');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /api/books/:id (Update Success -> 200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code (Revised Edition)\",\n  \"price\": 38.50\n}"
