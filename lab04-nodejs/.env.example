# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB Community Server or MongoDB Atlas)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/booknest

# MongoDB Atlas cluster example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknest?retryWrites=true&w=majority

# Database Name
DB_NAME=booknest

# Client Authentication Key (optional header: x-api-key)
API_KEY=booknest-secret-key-2026
